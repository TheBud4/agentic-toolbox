{
  "permissions": {
    "allow": [
      "WebFetch(domain:registry.khronos.org)",
      "WebFetch(domain:docs.vulkan.org)",
      "WebFetch(domain:www.glfw.org)",
      "WebFetch(domain:en.cppreference.com)",
      "WebFetch(domain:man7.org)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "Bash(go doc:*)",
      "Bash(man:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/bin/guard.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/bin/carregar.sh" }
        ]
      }
    ]
  }
}
